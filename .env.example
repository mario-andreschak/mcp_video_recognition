# Google Gemini API key (required when Gemini is selected)
GOOGLE_API_KEY=your_api_key_here

# Transport: 'stdio' or 'streamable-http' (defaults to 'stdio').
# The legacy value 'sse' is an alias for Streamable HTTP, not legacy SSE.
TRANSPORT_TYPE=stdio

# Streamable HTTP bind settings
MCP_HOST=127.0.0.1
PORT=3000

# Log level: 'verbose', 'debug', 'info', 'warn', 'error', 'fatal'
# Diagnostics always go to stderr; default is 'info'.
LOG_LEVEL=info

# HTTP requires a random 32+ character token and existing media roots.
# MCP_AUTH_TOKEN=replace_with_random_token
# ALLOWED_MEDIA_ROOTS=/absolute/media/root
GEMINI_MODEL=gemini-3.5-flash
# Limits and cleanup: docs/2026-MIGRATION.md
