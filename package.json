{
  "name": "mcp-video-recognition",
  "version": "2.0.0",
  "description": "MCP server and standalone client for image, audio, and video recognition",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "client": "npm run build --silent && node dist/client.js",
    "dev": "tsc -w & node --watch dist/index.js",
    "debug": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js",
    "lint": "eslint src",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check:canonical-invariants": "node scripts/check-canonical-invariants.mjs",
    "verify:provider-foundation": "npm run build && npm test",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "check": "npm run typecheck && npm run lint && npm test",
    "test:package": "node scripts/package-acceptance.mjs"
  },
  "keywords": [
    "mcp",
    "gemini",
    "video",
    "audio",
    "image",
    "recognition"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google/genai": "2.21.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/node": "^22.14.1",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.62.1"
  },
  "bin": {
    "mcp-video-recognition": "dist/index.js",
    "mcp-video-recognition-client": "dist/client.js"
  },
  "exports": {
    "./server": "./dist/server.js",
    "./providers/gemini": "./dist/services/gemini.js"
  },
  "files": [
    "dist",
    "!dist/tests",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    ".env.example",
    "docs"
  ]
}
